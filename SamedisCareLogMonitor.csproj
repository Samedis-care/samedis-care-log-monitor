<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>SamedisCareLogMonitor</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- The mail transports, the log format and the configuration reader now come from the
	     shared packages. MailKit, Graph, Gmail and Azure.Identity arrive through
	     SamedisCare.Mail, so they are no longer listed here. -->
	<ItemGroup>
		<PackageReference Include="SamedisCare.Mail" Version="0.3.0-rc.21" />
		<PackageReference Include="SamedisCare.Helper" Version="0.3.0-rc.21" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SamedisCareLogMonitor.Tests" />
	</ItemGroup>

	<!-- The project file sits at the repository root, so the default glob would compile the
	     test project's sources into this one — where xunit is not referenced. -->
	<ItemGroup>
		<Compile Remove="tests/**" />
		<None Remove="tests/**" />
	</ItemGroup>
</Project>
